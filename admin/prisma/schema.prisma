// Prisma schema — High-Five English LMS 관리자 시스템 (MVP)
// 범위: 사이트 마스터 · 회원(학생) · 강사 · 레벨테스트 · 수강신청 · 수업세션(전체일정표)
// 모든 테이블에 siteId를 넣어 멀티테넌트 확장에 대비하되, 지금은 site id=1 고정 운영.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 사이트 / 협력사
// ---------------------------------------------------------------------------

model Site {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  domain    String?
  status    String   @default("active")
  createdAt DateTime @default(now())

  agents          Agent[]
  students        Student[]
  teachers        Teacher[]
  enrollments     Enrollment[]
  levelTests      LevelTest[]
  classSessions   ClassSession[]
  instructors     Instructor[]
  pricingDurations PricingDuration[]
  leaveRequests   LeaveRequest[]
  monthlyEvaluations MonthlyEvaluation[]

  @@map("sites")
}

model Agent {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id])
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  students    Student[]
  enrollments Enrollment[]
  levelTests  LevelTest[]

  @@index([siteId])
  @@map("agents")
}

// ---------------------------------------------------------------------------
// 회원 (학생)
// ---------------------------------------------------------------------------

enum StudentGrade {
  ADMIN
  AGENT
  BRANCH
  GENERAL
}

enum StudentStatus {
  ACTIVE
  EXPIRED
  HOLDING
}

enum Sex {
  MALE
  FEMALE
}

enum ResidenceRegion {
  KOREA
  CHINA
  VIETNAM
  JAPAN
  AUSTRALIA
  USA_OTHER
}

model Student {
  id           Int           @id @default(autoincrement())
  siteId       Int
  site         Site          @relation(fields: [siteId], references: [id])
  agentId      Int?
  agent        Agent?        @relation(fields: [agentId], references: [id])
  name         String
  loginId      String        @unique
  passwordHash String
  grade        StudentGrade  @default(GENERAL)
  points       Int           @default(0)
  discountRate Decimal       @default(0) @db.Decimal(5, 2)
  status       StudentStatus @default(ACTIVE)
  joinedAt     DateTime      @default(now())
  lastLoginAt  DateTime?

  // 프로필 상세 정보 — 레퍼런스 사이트(z01.htm 학생정보수정)의 필드를 대부분 반영.
  // 협력사 브랜딩(로고/공지)은 Agent 자체의 설정이라 여기 포함하지 않고, 포인트
  // 적립/사용 내역은 원장(ledger) 테이블이 필요한 별도 기능이라 이번 범위에서 제외.
  englishName          String?
  sex                  Sex?
  birthDate            DateTime?
  occupation           String?
  region               ResidenceRegion?
  address              String?
  landlinePhone        String?
  mobilePhone          String?
  etcNote              String?           @db.Text
  parentName           String?
  parentContact        String?
  preferredClassMethod String?
  smsOptIn             Boolean           @default(true)
  teamsId              String?
  referrerId           String?

  enrollments       Enrollment[]
  levelTests        LevelTest[]
  classSessions     ClassSession[]
  consultationNotes ConsultationNote[]
  leaveRequests     LeaveRequest[]
  monthlyEvaluations MonthlyEvaluation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([agentId])
  @@map("students")
}

model ConsultationNote {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  adminId   Int?
  content   String
  createdAt DateTime @default(now())

  @@index([studentId])
  @@map("consultation_notes")
}

// ---------------------------------------------------------------------------
// 강사
// ---------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeacherGrade {
  SENIOR
  GENERAL
}

model Teacher {
  id             Int            @id @default(autoincrement())
  siteId         Int
  site           Site           @relation(fields: [siteId], references: [id])
  realName       String
  nickname       String?
  loginId        String         @unique
  passwordHash   String
  nationality    String?
  timezoneOffset Int? // UTC 대비 분(minute) 오프셋
  teamLeaderId   Int?
  teamLeader     Teacher?       @relation("TeamLead", fields: [teamLeaderId], references: [id])
  teamMembers    Teacher[]      @relation("TeamLead")
  email          String?
  approvalStatus ApprovalStatus @default(PENDING)
  joinedAt       DateTime       @default(now())
  lastLoginAt    DateTime?

  // 프로필 상세 정보 — 레퍼런스 사이트(z02.htm 강사정보수정)의 필드를 대부분 반영.
  // 사진/음성은 마케팅용 강사소개(Instructor)와는 별개로, LMS 내부에서 신원 확인 등
  // 운영 목적으로만 쓰는 참고용 데이터다.
  teacherGrade     TeacherGrade @default(GENERAL)
  sex              Sex?
  age              Int?
  schoolName       String?
  major            String?
  address          String?
  availableTimeText String?
  availableHours   Int[] // 0~23, 근무 가능 시간대(시간 단위)
  mobilePhone      String?
  teamsId          String?
  zoomUrl          String?
  zoomPw           String?
  tencentUrl       String?
  experience       String?  @db.Text
  selfIntroduction String?  @db.Text
  photoUrl         String?  @db.Text
  voiceUrl         String?  @db.Text
  videoYoutubeCode String?
  tesol            Boolean  @default(false)
  priority         Int      @default(0)

  rates         TeacherRate[]
  enrollments   Enrollment[]
  classSessions ClassSession[]
  levelTests    LevelTest[]
  monthlyEvaluations MonthlyEvaluation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@map("teachers")
}

model TeacherRate {
  id            Int      @id @default(autoincrement())
  teacherId     Int
  teacher       Teacher  @relation(fields: [teacherId], references: [id])
  ratePerUnit   Decimal  @db.Decimal(10, 2)
  unitMinutes   Int      @default(25)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  @@index([teacherId])
  @@map("teacher_rates")
}

// ---------------------------------------------------------------------------
// 수강 / 수업 세션
// ---------------------------------------------------------------------------

enum EnrollmentStatus {
  APPLIED
  PAID
  ACTIVE
  HOLDING
  COMPLETED
  RENEWED
  LOST
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}

model Enrollment {
  id               Int              @id @default(autoincrement())
  siteId           Int
  site             Site             @relation(fields: [siteId], references: [id])
  agentId          Int?
  agent            Agent?           @relation(fields: [agentId], references: [id])
  studentId        Int
  student          Student          @relation(fields: [studentId], references: [id])
  teacherId        Int?
  teacher          Teacher?         @relation(fields: [teacherId], references: [id])
  packageMonths    Int
  classMethod      String
  scheduleDays     String
  classDurationMin Int              @default(25)
  totalSessions    Int
  startDate        DateTime
  endDate          DateTime
  status           EnrollmentStatus @default(APPLIED)
  paymentStatus    PaymentStatus?
  orderNo          String?
  classType        String           @default("1:1")
  textbookId       Int?

  classSessions ClassSession[]
  leaveRequests LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([studentId])
  @@index([teacherId])
  @@map("enrollments")
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MAKEUP_NEEDED
  LEAVE // 학생 휴강 신청으로 결석 처리된 수업 — 회차 미차감, 수강기간 자동 연장
}

model ClassSession {
  id           Int           @id @default(autoincrement())
  siteId       Int
  site         Site          @relation(fields: [siteId], references: [id])
  enrollmentId Int
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id])
  studentId    Int
  student      Student       @relation(fields: [studentId], references: [id])
  teacherId    Int
  teacher      Teacher       @relation(fields: [teacherId], references: [id])
  scheduledAt  DateTime
  durationMin  Int           @default(25)
  status       SessionStatus @default(SCHEDULED)
  attendance   String?
  progressNote String?

  // 소프트 삭제 — "수업 삭제 내역"에서 이력으로 조회할 수 있도록 실제로 지우지 않고
  // deletedAt만 채운다. 전체일정표/충돌감지 등 나머지 조회는 전부 deletedAt: null만 본다.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluation   LessonEvaluation?
  leaveRequest LeaveRequest?

  @@index([siteId])
  @@index([scheduledAt])
  @@index([teacherId])
  @@index([studentId])
  @@map("class_sessions")
}

// 일일평가서 — 수업 1회당 1개, 강사가 수업 직후 작성. 2000자 제한은 DB(VarChar(2000))와
// 폼 양쪽에서 강제한다. ClassSession에 이미 student/teacher/scheduledAt이 있으므로
// 이 테이블엔 본문만 두고 나머지는 관계를 통해 조회한다.
model LessonEvaluation {
  id             Int          @id @default(autoincrement())
  classSessionId Int          @unique
  classSession   ClassSession @relation(fields: [classSessionId], references: [id])
  content        String       @db.VarChar(2000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lesson_evaluations")
}

// 월평가서 — 학생 1명당 특정 월(yearMonth, "YYYY-MM")에 1개, 관리자가 그 달의 전체
// 수업을 종합해 작성/수정한다. 일일평가서보다 분량이 많을 수 있어 길이 제한을 더 넉넉히 둔다.
model MonthlyEvaluation {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id])
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  teacherId Int?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  yearMonth String // "YYYY-MM"
  content   String   @db.VarChar(4000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, yearMonth])
  @@index([siteId])
  @@map("monthly_evaluations")
}

// 휴강 신청 — 학생이 예정된(SCHEDULED) 수업을 직접 휴강 처리하면 관리자 승인 없이
// 즉시 적용된다: 해당 ClassSession은 LEAVE 상태로 바뀌어 총 회차에서 차감되지
// 않고, 연결된 Enrollment.endDate가 extendedDays만큼 자동으로 늘어나 관리자가
// 별도로 일정을 재조정하지 않아도 된다. 관리자는 /leave-requests 화면에서
// 이력을 보고 필요 시 되돌릴(취소) 수 있다.
model LeaveRequest {
  id             Int          @id @default(autoincrement())
  siteId         Int
  site           Site         @relation(fields: [siteId], references: [id])
  classSessionId Int          @unique
  classSession   ClassSession @relation(fields: [classSessionId], references: [id])
  enrollmentId   Int
  enrollment     Enrollment   @relation(fields: [enrollmentId], references: [id])
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id])
  reason         String?
  extendedDays   Int          @default(1)

  createdAt DateTime @default(now())

  @@index([siteId])
  @@index([studentId])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// 레벨테스트
// ---------------------------------------------------------------------------

model LevelTest {
  id                     Int       @id @default(autoincrement())
  siteId                 Int
  site                   Site      @relation(fields: [siteId], references: [id])
  agentId                Int?
  agent                  Agent?    @relation(fields: [agentId], references: [id])
  // 공개 리드 폼(메인 사이트의 "무료 레벨테스트 신청")으로 들어온 건은 아직 계정이
  // 없으므로 studentId가 null이고 아래 lead* 필드가 채워진다. 관리자가 실제 학생
  // 계정과 연결/생성하면 studentId를 채워 정식 레벨테스트로 전환한다.
  studentId              Int?
  student                Student?  @relation(fields: [studentId], references: [id])
  teacherId              Int?
  teacher                Teacher?  @relation(fields: [teacherId], references: [id])
  subject                String?
  classMethod            String?
  appliedAt              DateTime  @default(now())
  scheduledTestDate      DateTime?
  scheduledClassDatetime DateTime?
  evaluationStatus       String?
  progressStatus         String?
  consultationStatus     String?

  // 리드 폼 전용 필드 — 메인 사이트 공개 신청 폼(src/components/modals/LevelTestModal.tsx)의
  // 입력값을 그대로 저장한다. studentId가 채워지면 더 이상 필요 없어지지만 이력으로 남긴다.
  leadContactName     String?
  leadContactPhone    String?
  leadPreferredTimeUTC DateTime?
  leadPreferredTimeZone String?
  leadLessonFrequency String?
  leadLessonDurationMin Int?
  leadMeetingPlatform String?
  leadReferredTeacherName String?
  leadStudentEnglishName String?
  leadStudentAge       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([studentId])
  @@map("level_tests")
}

// ---------------------------------------------------------------------------
// 강사소개 (마케팅 사이트 공개 프로필) — LMS 운영용 Teacher와는 별개 개념.
// slug는 메인 Vite 사이트의 기존 정적 강사 id(sarah/james/emily/daniel)와 맞춰두면
// 참고하기 쉽지만, 이 테이블 자체가 그 사이트의 교사 로그인/수강 연결과는 무관하다.
// ---------------------------------------------------------------------------

model Instructor {
  id             Int      @id @default(autoincrement())
  siteId         Int
  site           Site     @relation(fields: [siteId], references: [id])
  slug           String   @unique
  name           String
  nameEn         String
  country        String
  flag           String
  gradient       String
  photoUrl       String?  @db.Text
  audioSrc       String?  @db.Text
  defaultMeetingPlatform String?
  bio            String   @db.Text
  career         String[]
  availableDays  Int[]
  availableHours String
  classFeatures  String[]
  specialties    String[]
  levels         String[]
  teachingStyle  String
  published      Boolean  @default(true)
  order          Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@map("instructors")
}

// ---------------------------------------------------------------------------
// 화상영어 가격표 — 기간(1/3/6개월) × 빈도(주2/3/5회) × 수업시간(25/50분) ×
// 통화(KRW/CNY/VND). 통화별 가격은 서로 독립적으로 저장되며 환율 자동 환산이
// 아니다(src/data/currencies.ts의 기존 설계 원칙 그대로 유지).
// ---------------------------------------------------------------------------

model PricingDuration {
  id       Int      @id @default(autoincrement())
  siteId   Int
  site     Site     @relation(fields: [siteId], references: [id])
  code     String
  hasBadge Boolean  @default(false)
  order    Int      @default(0)
  rows     PricingRow[]

  @@unique([siteId, code])
  @@index([siteId])
  @@map("pricing_durations")
}

model PricingRow {
  id          Int             @id @default(autoincrement())
  durationId  Int
  duration    PricingDuration @relation(fields: [durationId], references: [id])
  frequencyId String
  price25KRW  Int?
  price25CNY  Int?
  price25VND  Int?
  price50KRW  Int?
  price50CNY  Int?
  price50VND  Int?

  @@unique([durationId, frequencyId])
  @@map("pricing_rows")
}
