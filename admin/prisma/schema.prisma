// Prisma schema — High-Five English LMS 관리자 시스템 (MVP)
// 범위: 사이트 마스터 · 회원(학생) · 강사 · 레벨테스트 · 수강신청 · 수업세션(전체일정표)
// 모든 테이블에 siteId를 넣어 멀티테넌트 확장에 대비하되, 지금은 site id=1 고정 운영.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 권한 시스템 (RBAC)
// ---------------------------------------------------------------------------

enum RoleName {
  ADMIN
  MANAGER
  TEACHER
  STUDENT
  // 협력사 관리자 — 자기 협력사(agentId)로 스코프된 데이터만 보고 관리한다. AdminUser.agentId가
  // 이 역할에서만 채워진다.
  AGENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  ACCOUNT_CREATED
  ACCOUNT_DISABLED
  ROLE_CHANGED
  PERMISSION_CHANGED
  CREATE
  UPDATE
  DELETE
  IMPERSONATION_STARTED
  IMPERSONATION_ENDED
  SCHEDULE_CREATED
  SCHEDULE_UPDATED
  SCHEDULE_CANCELLED
  EVALUATION_CREATED
  EVALUATION_UPDATED
  LEAVE_REQUESTED
  LEAVE_APPROVED
  LEAVE_REJECTED
}

// ADMIN/MANAGER 전용 로그인 계정. TEACHER/STUDENT는 각자의 테이블(Teacher/Student)에
// 이미 실계정+로그인이 있으므로 여기 포함하지 않는다 — 이 테이블은 지금까지 계정 자체가
// 없던 두 역할(단일 공유 admin/0000 로그인만 있던 ADMIN, 아예 없던 MANAGER)만 채운다.
model AdminUser {
  id           Int           @id @default(autoincrement())
  siteId       Int
  site         Site          @relation(fields: [siteId], references: [id])
  loginId      String        @unique
  passwordHash String
  name         String
  role         RoleName
  status       AccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // role=AGENT일 때만 채워진다 — 이 계정이 어느 협력사 소속인지, 데이터 스코핑의 기준이 된다.
  agentId Int?
  agent   Agent? @relation(fields: [agentId], references: [id])

  // "정보수정" 화면(협력사 관리자 자기 계정 수정)에서 쓰는 개인 프로필 항목 — Agent의
  // biz* 필드(마케팅사이트에 공개 노출되는 회사 정보)와는 별개의, 계정 자체에 딸린 정보다.
  engName  String?
  email    String?
  phone    String?
  kakaoId  String?
  wechatId String?

  @@index([siteId])
  @@index([agentId])
  @@map("admin_users")
}

model Permission {
  id          Int    @id @default(autoincrement())
  key         String @unique
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

// ADMIN용 행은 의도적으로 만들지 않는다 — ADMIN은 코드에서 항상 전체 허용하고 이
// 테이블을 조회하지 않으므로, 있으나 없으나 의미가 없다. 권한관리 화면도 ADMIN을
// 편집 대상에서 제외해 "ADMIN이 자기 권한을 지워 잠기는" 상황을 원천 차단한다.
model RolePermission {
  role         RoleName
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([role, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id          Int         @id @default(autoincrement())
  actorRole   RoleName?
  actorId     Int?
  actorName   String?
  action      AuditAction
  targetType  String?
  targetId    String?
  description String?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// 사이트 / 협력사
// ---------------------------------------------------------------------------

model Site {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  domain    String?
  status    String   @default("active")
  createdAt DateTime @default(now())

  agents             Agent[]
  adminUsers         AdminUser[]
  students           Student[]
  teachers           Teacher[]
  enrollments        Enrollment[]
  levelTests         LevelTest[]
  classSessions      ClassSession[]
  pricingDurations   PricingDuration[]
  leaveRequests      LeaveRequest[]
  academyClosures    AcademyClosure[]
  monthlyEvaluations MonthlyEvaluation[]
  bulletins          Bulletin[]
  enrollmentRequests EnrollmentRequest[]
  homeNotices        HomeNotice[]
  consultChannels    ConsultChannel[]
  reviewPosts        ReviewPost[]
  slotReservations   SlotReservation[]

  @@map("sites")
}

// 협력사(맘앤맘/시너지 등) — 본사(highfive)를 포함해 전부 이 모델의 행이다. 아래
// 브랜딩/회사정보/계좌 필드는 협력사 마케팅사이트(같은 코드, 접속 도메인으로 구분)가
// 자기 정보를 동적으로 보여주는 데 쓴다 — 본사 관리자가 이 필드들을 수정하면 다음
// 요청부터 그 협력사 사이트에 바로 반영된다(agency-branding 공개 API 참고). 전부
// null이면 본사(highfive) 사이트의 정적 기본값으로 대체된다.
model Agent {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id])
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  // 마케팅사이트 접속 도메인 — 이 값으로 "지금 어느 협력사 사이트인지" 판별한다.
  domain            String? @unique
  // 로고 이미지 URL(협력사 업로드분 또는 관리자가 직접 입력한 링크).
  logoUrl           String?
  brandTagline      String?
  // 회사(사업자) 정보 — 마케팅사이트 하단 푸터에 그대로 노출된다.
  bizName           String?
  bizCeo            String?
  bizRegNo          String?
  bizAddress        String?
  bizPhone          String?
  bizEmail          String?
  bizMailOrderNo    String?
  // 무통장입금 계좌 정보.
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?

  students         Student[]
  enrollments      Enrollment[]
  levelTests       LevelTest[]
  slotReservations SlotReservation[]
  consultChannels  ConsultChannel[]
  pricingDurations PricingDuration[]
  homeNotices      HomeNotice[]
  reviewPosts      ReviewPost[]
  adminUsers       AdminUser[]
  academyClosures  AcademyClosure[]

  @@index([siteId])
  @@map("agents")
}

// ---------------------------------------------------------------------------
// 회원 (학생)
// ---------------------------------------------------------------------------

enum StudentGrade {
  ADMIN
  AGENT
  BRANCH
  GENERAL
}

enum StudentStatus {
  ACTIVE
  EXPIRED
  HOLDING
}

enum Sex {
  MALE
  FEMALE
}

enum ResidenceRegion {
  KOREA
  CHINA
  VIETNAM
  JAPAN
  AUSTRALIA
  USA_OTHER
}

// 상담을 위챗/카카오톡 중 어느 채널로 하는지 — 강사 스케줄 구글시트에서 학생 이름
// 앞에 위챗 표시(w)를 붙이는 데 쓰인다(연락처 ID 필드와는 별개로, "주 상담 채널"만 표시).
enum ConsultRoute {
  WECHAT
  KAKAOTALK
}

model Student {
  id            Int           @id @default(autoincrement())
  siteId        Int
  site          Site          @relation(fields: [siteId], references: [id])
  agentId       Int?
  agent         Agent?        @relation(fields: [agentId], references: [id])
  name          String
  loginId       String        @unique
  passwordHash  String
  grade         StudentGrade  @default(GENERAL)
  points        Int           @default(0)
  discountRate  Decimal       @default(0) @db.Decimal(5, 2)
  status        StudentStatus @default(ACTIVE)
  // 로그인 가능 여부를 결정하는 계정 상태 — 위 StudentStatus(수강 진행 상태: 진행/만료/홀딩)와는
  // 별개 축이다. INACTIVE/SUSPENDED면 status와 무관하게 로그인이 차단된다.
  accountStatus AccountStatus @default(ACTIVE)
  joinedAt      DateTime      @default(now())
  lastLoginAt   DateTime?

  // 프로필 상세 정보 — 레퍼런스 사이트(z01.htm 학생정보수정)의 필드를 대부분 반영.
  // 협력사 브랜딩(로고/공지)은 Agent 자체의 설정이라 여기 포함하지 않고, 포인트
  // 적립/사용 내역은 원장(ledger) 테이블이 필요한 별도 기능이라 이번 범위에서 제외.
  englishName          String?
  sex                  Sex?
  birthDate            DateTime?
  occupation           String?
  region               ResidenceRegion?
  address              String?
  landlinePhone        String?
  mobilePhone          String?
  etcNote              String?          @db.Text
  parentName           String?
  parentContact        String?
  preferredClassMethod String?
  smsOptIn             Boolean          @default(true)
  teamsId              String?
  kakaoId              String?
  wechatId             String?
  consultRoute         ConsultRoute?
  kakaoUserId          String?          @unique
  email                String?
  referrerId           String?

  // 소프트 삭제 — 수강내역/레벨테스트/결제/상담노트 등 연결 데이터가 있을 수 있어
  // 실제로 지우지 않고 deletedAt만 채운다. 학생 목록은 deletedAt: null만 보여준다.
  deletedAt DateTime?

  enrollments        Enrollment[]
  levelTests         LevelTest[]
  classSessions      ClassSession[]
  consultationNotes  ConsultationNote[]
  leaveRequests      LeaveRequest[]
  monthlyEvaluations MonthlyEvaluation[]
  enrollmentRequests EnrollmentRequest[]
  reviewPosts        ReviewPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([agentId])
  @@map("students")
}

model ConsultationNote {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id])
  adminId   Int?
  content   String
  createdAt DateTime @default(now())

  @@index([studentId])
  @@map("consultation_notes")
}

// ---------------------------------------------------------------------------
// 강사
// ---------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeacherGrade {
  SENIOR
  GENERAL
}

model Teacher {
  id             Int            @id @default(autoincrement())
  siteId         Int
  site           Site           @relation(fields: [siteId], references: [id])
  realName       String
  nickname       String?
  loginId        String         @unique
  passwordHash   String
  nationality    String?
  timezoneOffset Int? // UTC 대비 분(minute) 오프셋
  teamLeaderId   Int?
  teamLeader     Teacher?       @relation("TeamLead", fields: [teamLeaderId], references: [id])
  teamMembers    Teacher[]      @relation("TeamLead")
  email          String?
  approvalStatus ApprovalStatus @default(PENDING)
  // 로그인 가능 여부를 결정하는 계정 상태 — 위 approvalStatus(채용 승인 워크플로우)와는
  // 별개 축이다. deleteTeacher는 실제로 이 값을 INACTIVE로 바꾸는 소프트 비활성화다.
  accountStatus  AccountStatus  @default(ACTIVE)
  joinedAt       DateTime       @default(now())
  lastLoginAt    DateTime?

  // 프로필 상세 정보 — 레퍼런스 사이트(z02.htm 강사정보수정)의 필드를 대부분 반영.
  // 사진/음성은 마케팅용 강사소개(Instructor)와는 별개로, LMS 내부에서 신원 확인 등
  // 운영 목적으로만 쓰는 참고용 데이터다.
  teacherGrade     TeacherGrade @default(GENERAL)
  sex              Sex?
  age              Int?
  schoolName       String?
  major            String?
  address          String?
  // 오전 6시~밤 12시, 30분 단위 근무 가능 시간대 — 자정 기준 분(minute-of-day) 값의
  // 배열(예: 06:00=360, 06:30=390). src/lib/timeSlots.ts 참고. 홈페이지 강사소개의
  // "근무시간" 표시가 이 값을 그대로 사용한다.
  availableHours   Int[]
  mobilePhone      String?
  teamsId          String?
  teamsUrl         String?
  zoomUrl          String?
  zoomPw           String?
  tencentUrl       String?
  experience       String?      @db.Text
  selfIntroduction String?      @db.Text
  photoUrl         String?      @db.Text
  voiceUrl         String?      @db.Text
  videoYoutubeCode String?
  tesol            Boolean      @default(false)
  priority         Int          @default(0)

  rates              TeacherRate[]
  enrollments        Enrollment[]
  classSessions      ClassSession[]
  levelTests         LevelTest[]
  monthlyEvaluations MonthlyEvaluation[]
  slotReservations   SlotReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@map("teachers")
}

model TeacherRate {
  id            Int      @id @default(autoincrement())
  teacherId     Int
  teacher       Teacher  @relation(fields: [teacherId], references: [id])
  ratePerUnit   Decimal  @db.Decimal(10, 2)
  unitMinutes   Int      @default(25)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  @@index([teacherId])
  @@map("teacher_rates")
}

// ---------------------------------------------------------------------------
// 수강 / 수업 세션
// ---------------------------------------------------------------------------

enum EnrollmentStatus {
  APPLIED
  PAID
  ACTIVE
  HOLDING
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}

model Enrollment {
  id                 Int              @id @default(autoincrement())
  siteId             Int
  site               Site             @relation(fields: [siteId], references: [id])
  agentId            Int?
  agent              Agent?           @relation(fields: [agentId], references: [id])
  studentId          Int
  student            Student          @relation(fields: [studentId], references: [id])
  teacherId          Int?
  teacher            Teacher?         @relation(fields: [teacherId], references: [id])
  packageMonths      Int
  classMethod        String
  scheduleDays       String
  classDurationMin   Int              @default(25)
  totalSessions      Int
  startDate          DateTime
  endDate            DateTime
  status             EnrollmentStatus @default(APPLIED)
  // status가 HOLDING인 동안 홀드가 시작된 시점 — 해제 시 이 값으로부터 며칠(주 단위로
  // 올림) 홀드됐는지 계산해 예정 수업(HOLD 상태)들을 그만큼 뒤로 밀고 수강기간도 같이
  // 늘린다(holdApply.ts 참고). HOLDING이 아닐 때는 항상 null이다.
  holdStartedAt      DateTime?
  paymentStatus      PaymentStatus?
  orderNo            String?
  classType          String           @default("1:1")
  textbookId         Int?
  // 교재 테이블이 아직 없어 이름을 그대로 저장한다(textbookId는 미사용 상태로 남겨둠 —
  // 이후 Textbook 모델을 만들면 이 값을 기준으로 이관한다).
  textbookName       String?
  // 수업 시각(HH:mm) — scheduleDays는 요일만 담고 있어 시각 정보가 없었다.
  classTime          String?
  // 요일별로 수업 시간이 다른 경우의 오버라이드 — {"1": "20:00", "3": "20:30"} 형태로
  // WEEKDAYS의 value(0=일~6=토)를 키로 저장한다. 없는 요일은 위 classTime을 그대로 쓴다.
  // 강사(teacherId)는 이 등록 건 전체에서 하나로 고정되어 있어 요일별로 다르게 배정할
  // 수는 없다 — 요일별 강사 배정이 필요해지면 별도 모델링이 필요하다.
  classTimes         Json?
  // 학생 수준 — 1~10 단계 숫자 문자열("1".."10"). 레벨테스트 결과와는 별개로, 이
  // 수강 건을 어떤 난이도로 진행할지 관리자가 직접 지정한다.
  studentLevel       String?
  // 강사가 부를 학생 영어 이름 — 학생 프로필의 englishName을 기본값으로 쓰되, 등록
  // 시점에 이 수강 건만 다르게 표기하고 싶을 때 덮어쓸 수 있도록 별도로 저장한다.
  studentEnglishName String?
  // 커리큘럼 — 교재와 마찬가지로 아직 전용 카탈로그 모델이 없어 자유 텍스트로 저장한다.
  curriculum         String?
  adminNote          String?          @db.Text
  // 실제 청구 수강료(KRW) — null이면 가격표(PricingDuration/PricingRow, packageMonths ×
  // scheduleDays 빈도 × classDurationMin 기준)에서 계산한 기본 수강료를 그대로 쓴다는
  // 뜻이다. 지인할인·프로모션·포인트 사용 등으로 기본 수강료와 실제 청구액이 다를 때만
  // 값이 채워진다 — "수강내역관리 > 결제 > 수정" 화면에서만 설정한다.
  actualPriceKRW     Int?
  // "재수강" 등록 화면(/enrollments/new?renewFrom=<원본 id>)에서 저장할 때만 채워진다 —
  // 원본 수강 건을 이어서 새로 만든 건임을 표시한다. 원본 쪽에서 이 값으로 자신을
  // 가리키는 건이 있는지(renewals) 확인해 "재수강" 버튼 대신 "재수강 완료"를 보여준다.
  renewedFromId      Int?
  renewedFrom        Enrollment?      @relation("EnrollmentRenewal", fields: [renewedFromId], references: [id])
  renewals           Enrollment[]     @relation("EnrollmentRenewal")

  classSessions             ClassSession[]
  leaveRequests             LeaveRequest[]
  monthlyEvaluations        MonthlyEvaluation[]
  // 이 수강 건이 어떤 가예약(들)에서 등록전환된 것인지(있다면) — SlotReservation.convertedEnrollmentId의
  // 반대편. "주 N회" 예약은 요일마다 SlotReservation 행이 따로 있고 그 전부가 같은
  // Enrollment로 전환되므로 배열이다(예전엔 예약 1건=요일 1개라 1:1이었다). 대부분의
  // 수강 건은 가예약 없이 바로 등록되므로 빈 배열이다.
  convertedFromReservations SlotReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([studentId])
  @@index([teacherId])
  @@index([renewedFromId])
  @@map("enrollments")
}

// ---------------------------------------------------------------------------
// 강사 자리 가예약 (상담 단계 — 본사/협력사가 강사 빈자리를 미리 표시)
// ---------------------------------------------------------------------------

// 3곳(본사+협력사 2곳)이 같은 강사 풀을 공유한다. 상담 중 강사 빈자리를 미리
// 구글시트에 표시해뒀다가, 실제 등록으로 이어지면 CONVERTED로 바꾸고(자리는 그대로
// 유지, 표시만 정규 수업으로 바뀜), 상담이 불발되면 CANCELLED로 바꿔 자리를 비운다.
enum ReservationStatus {
  RESERVED
  CONVERTED
  CANCELLED
}

model SlotReservation {
  id     Int  @id @default(autoincrement())
  siteId Int
  site   Site @relation(fields: [siteId], references: [id])

  teacherId Int
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  // 이 자리를 가져가는 협력사 — null이면 본사(직영) 상담 건.
  agentId   Int?
  agent     Agent?  @relation(fields: [agentId], references: [id])

  // 0=일 ~ 6=토(WEEKDAY_DISPLAY_ORDER와 동일한 값 체계).
  weekday     Int
  classTime   String
  durationMin Int     @default(25)
  // 줌/텐센트/팀즈 등 — nullable로 둬서 기존 행(이 필드가 생기기 전에 만들어진 예약)은
  // null로 남고, 화면에서는 "미지정"으로 취급한다. Enrollment.classMethod와 같은 값
  // 체계(levelTestOptions.ts의 CLASS_METHOD_OPTIONS)를 그대로 쓴다.
  classMethod String?
  // "주 N회" 예약은 요일마다 이 행이 하나씩 생기는데, 그 여러 행을 하나의 예약 건으로
  // 묶는 식별자(예: crypto.randomUUID()) — 같은 상담자의 월/수/금 예약이 같은 groupId를
  // 가진다. 기존 행(이 필드가 생기기 전)은 null이고, 그런 행은 "그 행 혼자만 있는
  // 그룹"으로 취급한다(취소/전환 로직이 groupId가 null이면 id 기준으로 동작).
  groupId     String?

  // 아직 학생 계정이 없는(상담 단계) 예비 수강생 정보라 Student를 참조하지 않고
  // 자유 텍스트로 남긴다.
  prospectName String
  contactPhone String?
  note         String? @db.Text

  status ReservationStatus @default(RESERVED)

  // 등록으로 전환되면 실제 Enrollment를 가리킨다(CONVERTED 상태에서만 값이 있음).
  // 예전엔 예약 1건=요일 1개라 @unique(1:1)였지만, 이제 같은 그룹의 여러 행이 전부
  // 같은 Enrollment를 가리켜야 해서(주 N회 → 그 요일 수만큼의 행이 한 Enrollment로
  // 전환) unique 제약을 제거했다 — 여러 SlotReservation → 하나의 Enrollment(N:1).
  convertedEnrollmentId Int?
  convertedEnrollment   Enrollment? @relation(fields: [convertedEnrollmentId], references: [id])

  createdById Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([groupId])
  @@index([teacherId])
  @@index([agentId])
  @@map("slot_reservations")
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MAKEUP_NEEDED
  LEAVE // 학생 휴강 신청으로 결석 처리된 수업 — 회차 미차감, 수강기간 자동 연장
  HOLD // 수강 홀드(Enrollment.status=HOLDING) 기간 동안 멈춘 예정 수업 — holdApply.ts 참고.
  // 홀드가 풀리면 held된 일수만큼 뒤로 밀려 SCHEDULED로 복귀한다.
}

model ClassSession {
  id           Int           @id @default(autoincrement())
  siteId       Int
  site         Site          @relation(fields: [siteId], references: [id])
  enrollmentId Int
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id])
  studentId    Int
  student      Student       @relation(fields: [studentId], references: [id])
  teacherId    Int
  teacher      Teacher       @relation(fields: [teacherId], references: [id])
  scheduledAt  DateTime
  durationMin  Int           @default(25)
  status       SessionStatus @default(SCHEDULED)
  attendance   String?
  progressNote String?
  // 관리자가 "학생관리 > 수업관리"에서 즉석으로 추가한 보충수업인지 여부 — 정규
  // 스케줄로 자동 생성된 수업과 달리 담당 강사가 아닌 다른 강사가 대신 진행할 수
  // 있어, 강사/학생 화면 어디서든 이 수업만 별도로 표시해야 한다.
  isSupplement Boolean       @default(false)

  // 소프트 삭제 — "수업 삭제 내역"에서 이력으로 조회할 수 있도록 실제로 지우지 않고
  // deletedAt만 채운다. 전체일정표/충돌감지 등 나머지 조회는 전부 deletedAt: null만 본다.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluation   LessonEvaluation?
  leaveRequest LeaveRequest?

  @@index([siteId])
  @@index([scheduledAt])
  @@index([teacherId])
  @@index([studentId])
  @@map("class_sessions")
}

// 일일평가서 — 수업 1회당 1개, 강사가 수업 직후 작성. 2000자 제한은 DB(VarChar(2000))와
// 폼 양쪽에서 강제한다. ClassSession에 이미 student/teacher/scheduledAt이 있으므로
// 이 테이블엔 본문만 두고 나머지는 관계를 통해 조회한다.
model LessonEvaluation {
  id             Int          @id @default(autoincrement())
  classSessionId Int          @unique
  classSession   ClassSession @relation(fields: [classSessionId], references: [id])
  content        String       @db.VarChar(2000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lesson_evaluations")
}

// 월평가서 — 달력 월이 아니라 "그 수강 건의 몇 번째 회차 사이클"을 기준으로 한다.
// 사이클 길이(sessionsPerCycle)는 등록 당시 주당 수업 횟수로 정해진다(주2회=8회,
// 주3회=12회, 주4회=16회, 주5회=20회 — 약 4주치). 완료된 수업 수가 그 배수에 도달할
// 때마다 담당 강사가 강사페이지에서 작성한다(관리자도 대신 작성/수정 가능). 주당
// 횟수가 바뀌어도 이미 쓴 평가서의 sessionsPerCycle은 그대로 스냅샷으로 남아,
// 나중에 스케줄이 바뀌어도 과거 평가서의 회차 구간 해석이 달라지지 않는다.
model MonthlyEvaluation {
  id               Int        @id @default(autoincrement())
  siteId           Int
  site             Site       @relation(fields: [siteId], references: [id])
  studentId        Int
  student          Student    @relation(fields: [studentId], references: [id])
  teacherId        Int?
  teacher          Teacher?   @relation(fields: [teacherId], references: [id])
  enrollmentId     Int
  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id])
  cycleNumber      Int // 그 수강 건의 1부터 시작하는 회차 번호
  sessionsPerCycle Int // 작성 시점 기준 한 회차당 수업 수(8/12/16/20) — 스냅샷
  content          String     @db.VarChar(4000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, cycleNumber])
  @@index([siteId])
  @@map("monthly_evaluations")
}

// 휴강 신청 — 학생이 예정된(SCHEDULED) 수업을 직접 휴강 처리하면 관리자 승인 없이
// 즉시 적용된다: 해당 ClassSession은 LEAVE 상태로 바뀌어 총 회차에서 차감되지
// 않고, 연결된 Enrollment.endDate가 extendedDays만큼 자동으로 늘어나 관리자가
// 별도로 일정을 재조정하지 않아도 된다. 관리자는 /leave-requests 화면에서
// 이력을 보고 필요 시 되돌릴(취소) 수 있다.
model LeaveRequest {
  id             Int          @id @default(autoincrement())
  siteId         Int
  site           Site         @relation(fields: [siteId], references: [id])
  classSessionId Int          @unique
  classSession   ClassSession @relation(fields: [classSessionId], references: [id])
  enrollmentId   Int
  enrollment     Enrollment   @relation(fields: [enrollmentId], references: [id])
  studentId      Int
  student        Student      @relation(fields: [studentId], references: [id])
  reason         String?
  extendedDays   Int          @default(1)

  // Teacher Hold 승인 워크플로우 — Student/Admin 신청은 기존처럼 즉시 APPROVED로
  // 생성되어 그대로 적용되고(기존 데이터는 전부 이 케이스), Teacher 신청만 PENDING으로
  // 생성되어 ClassSession/Enrollment를 건드리지 않다가 관리자 승인 시점에 반영된다.
  status          ApprovalStatus @default(APPROVED)
  requestedByRole RoleName       @default(STUDENT)
  approvedById    Int?
  approvedAt      DateTime?

  // 전체수업휴강(어학원 휴강)으로 한 번에 여러 건이 함께 만들어진 경우에만 채워진다 —
  // 이 값으로 "학생이 직접/관리자가 개별로 신청한 휴강"과 "어학원 전체 휴강으로
  // 일괄 생성된 휴강"을 구분한다(휴강관리 화면의 세 탭 분류 기준).
  academyClosureId Int?
  academyClosure   AcademyClosure? @relation(fields: [academyClosureId], references: [id])

  createdAt DateTime @default(now())

  @@index([siteId])
  @@index([studentId])
  @@index([academyClosureId])
  @@map("leave_requests")
}

// 어학원 전체 휴강(공휴일 등으로 그날 예정된 모든 수업을 한 번에 휴강 처리) — 관리자가
// 휴강관리 화면에서 날짜를 고르고 사유를 입력하면, 그날 예정(SCHEDULED)된 모든
// ClassSession에 대해 LeaveRequest를 일괄 생성한다(각 건의 처리 자체는 개별 휴강과
// 동일한 applyClassLeave 로직을 재사용 — 그래야 학생별 수강 종료일 연장도 똑같이
// 적용된다). 이 레코드는 "그 날짜에 이런 사유로 일괄 휴강했다"는 사실 자체를 남겨,
// 휴강관리 화면에서 개별 휴강과 분리해서 보여주고 한 번에 되돌릴 수 있게 한다.
model AcademyClosure {
  id          Int      @id @default(autoincrement())
  siteId      Int
  site        Site     @relation(fields: [siteId], references: [id])
  date        DateTime
  reason      String
  createdById Int?
  createdAt   DateTime @default(now())

  // null = 본사가 등록한 전체(회사 전체) 휴강. 협력사(AGENT)가 등록하면 그 협력사
  // 소속 학생 수업에만 적용되고, 값이 채워진다 — 다른 협력사/본사 수업은 건드리지 않는다.
  agentId Int?
  agent   Agent? @relation(fields: [agentId], references: [id])

  leaveRequests LeaveRequest[]

  @@index([siteId])
  @@index([agentId])
  @@map("academy_closures")
}

// ---------------------------------------------------------------------------
// 게시판 — 관리자가 작성하는 공지, 강사는 읽기 전용으로 조회한다.
// ---------------------------------------------------------------------------

model Bulletin {
  id            Int    @id @default(autoincrement())
  siteId        Int
  site          Site   @relation(fields: [siteId], references: [id])
  title         String
  content       String @db.Text
  authorAdminId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@map("bulletins")
}

// ---------------------------------------------------------------------------
// 레벨테스트
// ---------------------------------------------------------------------------

model LevelTest {
  id                     Int       @id @default(autoincrement())
  siteId                 Int
  site                   Site      @relation(fields: [siteId], references: [id])
  agentId                Int?
  agent                  Agent?    @relation(fields: [agentId], references: [id])
  // 공개 리드 폼(메인 사이트의 "무료 레벨테스트 신청")으로 들어온 건은 아직 계정이
  // 없으므로 studentId가 null이고 아래 lead* 필드가 채워진다. 관리자가 실제 학생
  // 계정과 연결/생성하면 studentId를 채워 정식 레벨테스트로 전환한다.
  studentId              Int?
  student                Student?  @relation(fields: [studentId], references: [id])
  teacherId              Int?
  teacher                Teacher?  @relation(fields: [teacherId], references: [id])
  subject                String?
  classMethod            String?
  appliedAt              DateTime  @default(now())
  scheduledTestDate      DateTime?
  scheduledClassDatetime DateTime?
  evaluationStatus       String?
  progressStatus         String?
  consultationStatus     String?

  // 관리자 레벨테스트 신청 폼 입력값 — 선택지는 src/lib/levelTestOptions.ts가 단일 출처다.
  // 문자열로 두는 이유: 운영 중 항목이 추가/변경돼도 마이그레이션 없이 상수만 고치면 되고,
  // 이후 별도 관리 테이블로 승격할 때도 값을 그대로 옮길 수 있다.
  englishLevel  String?
  ageGroup      String?
  interestTopic String?
  teacherNote   String? @db.Text
  // 강사에게 전달할 사항(teacherNote)과 별개로, 관리자끼리만 보는 내부 메모.
  adminNote     String? @db.Text
  // 레벨테스트 결과(평가서) — 테스트를 진행한 뒤 그 결과를 정리한 내용. 관리자가
  // 목록의 "진행상태" 옆 "레벨테스트결과"에서 확인·수정한다.
  resultContent String? @db.Text

  // 결과 요약 — 상담·수강신청으로 바로 이어지는 가장 중요한 결론이라 resultContent
  // 자유 서술문 안에 묻히지 않도록 별도 필드로 분리한다(결과 화면 상단에 크게 표시).
  recommendedLevel    String?
  recommendedTextbook String?

  // 학생 거주지역(Student.region) 기준 자동 번역 캐시 — resultContent(강사가 영어로
  // 작성) 저장 시점에 함께 생성해서 저장해둔다(매 조회마다 번역 API를 부르지 않기
  // 위함). resultContentTranslatedLang은 이 캐시가 어떤 언어로 만들어졌는지 기록해,
  // resultContent나 학생의 거주지역이 바뀌면 다시 만들어야 하는지 판단하는 기준이
  // 된다. 영어권(호주/미국 등)이거나 거주지역 미입력이면 번역할 필요가 없으므로 둘 다
  // null로 둔다.
  resultContentTranslated     String? @db.Text
  resultContentTranslatedLang String?

  // 영역별 평가 점수(1~5) — 결과 화면의 레이더 차트에 쓰인다. 다섯 개 중 하나라도
  // 비어 있으면(테스트 전/평가 미완료) 차트 자체를 표시하지 않는다.
  scoreListening       Int?
  scoreSpeakingFluency Int?
  scoreSpeakingGrammar Int?
  scoreVocabulary      Int?
  scoreCompletion      Int?

  // 리드 폼 전용 필드 — 메인 사이트 공개 신청 폼(src/components/modals/LevelTestModal.tsx)의
  // 입력값을 그대로 저장한다. studentId가 채워지면 더 이상 필요 없어지지만 이력으로 남긴다.
  leadContactName         String?
  leadContactPhone        String?
  leadPreferredTimeUTC    DateTime?
  leadPreferredTimeZone   String?
  leadLessonFrequency     String?
  leadLessonDurationMin   Int?
  leadMeetingPlatform     String?
  leadReferredTeacherName String?
  leadStudentEnglishName  String?
  leadStudentAge          Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([studentId])
  @@map("level_tests")
}

// ---------------------------------------------------------------------------
// 화상영어 가격표 — 기간(1/3/6개월) × 빈도(주2/3/5회) × 수업시간(25/50분) ×
// 통화(KRW/CNY/VND). 통화별 가격은 서로 독립적으로 저장되며 환율 자동 환산이
// 아니다(src/data/currencies.ts의 기존 설계 원칙 그대로 유지).
// ---------------------------------------------------------------------------

// agentId가 null이면 본사(직영) 기본 가격표, 값이 있으면 그 협력사 전용 가격표다 —
// 협력사 사이트는 자기 agentId의 행이 있으면 그걸 쓰고 없으면 null(본사) 행으로
// 대체한다(agency-branding과 같은 폴백 규칙).
model PricingDuration {
  id       Int          @id @default(autoincrement())
  siteId   Int
  site     Site         @relation(fields: [siteId], references: [id])
  agentId  Int?
  agent    Agent?       @relation(fields: [agentId], references: [id])
  code     String
  hasBadge Boolean      @default(false)
  order    Int          @default(0)
  rows     PricingRow[]

  @@unique([siteId, agentId, code])
  @@index([siteId])
  @@index([agentId])
  @@map("pricing_durations")
}

model PricingRow {
  id          Int             @id @default(autoincrement())
  durationId  Int
  duration    PricingDuration @relation(fields: [durationId], references: [id])
  frequencyId String
  price25KRW  Int?
  price25CNY  Int?
  price25VND  Int?
  price50KRW  Int?
  price50CNY  Int?
  price50VND  Int?

  @@unique([durationId, frequencyId])
  @@map("pricing_rows")
}

// ---------------------------------------------------------------------------
// 마케팅 사이트(Vite) 공개 연동 — 수강신청 리드, 홈페이지 공지, 수강후기 게시판,
// 상담채널 설정. 모두 실제 방문자가 보거나 제출하는 공개 콘텐츠라 admin/src/app/api/
// public/*에서 CORS로 노출된다.
// ---------------------------------------------------------------------------

enum EnrollmentRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  CANCELLED
}

// 마케팅 사이트 "수강신청" 폼 제출 — 로그인한 실제 학생 계정만 제출 가능(레벨테스트
// 신청과 동일 정책). 실제 Enrollment가 아니라 리드일 뿐이라, 관리자가 검토 후 별도로
// 진짜 수강등록을 만든다.
model EnrollmentRequest {
  id                    Int                     @id @default(autoincrement())
  siteId                Int
  site                  Site                    @relation(fields: [siteId], references: [id])
  studentId             Int
  student               Student                 @relation(fields: [studentId], references: [id])
  meetingPlatform       String
  teamsId               String?
  curriculumTrack       String
  durationId            String
  lessonFrequency       String
  lessonDurationMin     Int
  weeklyDays            Int[]
  preferredStartDate    DateTime
  preferredStartTimeKST String
  pointsToUse           Int                     @default(0)
  status                EnrollmentRequestStatus @default(NEW)
  createdAt             DateTime                @default(now())

  @@index([siteId])
  @@index([studentId])
  @@map("enrollment_requests")
}

// 홈페이지 메인에 노출되는 공지 — 비로그인 방문자도 읽을 수 있는 공개 게시물.
// authorAdminId는 Bulletin과 동일하게 작성한 관리자를 참조만 하고(감사용), 정합성을
// 위해 강제 FK로 걸지 않는다.
// agentId가 null이면 본사 홈페이지 공지, 값이 있으면 그 협력사 사이트에만 노출되는
// 공지다 — 협력사 사이트는 자기 agentId 공지만 보여주고(본사 공지와 섞지 않는다,
// "각각 진행" 요구사항), 본사 사이트는 agentId가 null인 것만 보여준다.
model HomeNotice {
  id            Int      @id @default(autoincrement())
  siteId        Int
  site          Site     @relation(fields: [siteId], references: [id])
  agentId       Int?
  agent         Agent?   @relation(fields: [agentId], references: [id])
  title         String
  content       String   @db.Text
  published     Boolean  @default(false)
  authorAdminId Int?
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([siteId])
  @@index([agentId])
  @@map("home_notices")
}

// 상담채널 설정(카카오톡/위챗/고객센터 등) — 채널 종류(code: "kakao"/"wechat"/
// "customerService")는 seed로 고정된 소수만 존재하고, 관리자는 값/URL/노출여부만
// 수정한다(새 채널 추가는 코드 변경 필요, MeetingPlatformId와 동일한 확장 정책).
// agentId가 null이면 본사 기본 채널, 값이 있으면 그 협력사 전용 채널이다 — 협력사
// 사이트는 같은 code에 자기 agentId 행이 있으면 그걸 쓰고 없으면 null(본사) 행으로
// 대체한다.
model ConsultChannel {
  id          Int      @id @default(autoincrement())
  siteId      Int
  site        Site     @relation(fields: [siteId], references: [id])
  agentId     Int?
  agent       Agent?   @relation(fields: [agentId], references: [id])
  code        String
  displayName String
  value       String
  url         String?
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@unique([siteId, agentId, code])
  @@index([siteId])
  @@index([agentId])
  @@map("consult_channels")
}

// 수강후기 게시판 — 로그인한 실제 학생만 글/답글 작성 가능. parentId가 없으면 최상위
// 게시글, 있으면 그 글의 답글(한 단계 중첩, 기존 mock 게시판과 동일). 홈페이지 노출용
// 큐레이션(featuredOnHome)은 폐기 — 이 게시판은 로그인 후에만 보이는 순수 게시판이다.
// agentId는 글쓴 학생의 소속 협력사를 저장 시점에 그대로 복사해둔 값이다(글쓴 뒤
// 학생이 협력사를 옮겨도 게시글은 원래 협력사 게시판에 남아야 하므로 매번 조인하지
// 않고 스냅샷으로 저장) — "각각 진행" 요구사항대로 협력사 사이트는 자기 agentId
// 글만, 본사 사이트는 agentId가 null인 글만 보여준다.
model ReviewPost {
  id              Int          @id @default(autoincrement())
  siteId          Int
  site            Site         @relation(fields: [siteId], references: [id])
  agentId         Int?
  agent           Agent?       @relation(fields: [agentId], references: [id])
  parentId        Int?
  parent          ReviewPost?  @relation("ReviewReplies", fields: [parentId], references: [id])
  replies         ReviewPost[] @relation("ReviewReplies")
  // 학생 글은 studentId로, 관리자 글(댓글 포함 — "관리자도 댓글/작성 가능")은 authorAdminName만
  // 채우고 studentId는 비운다. 관리자에게는 별도 계정 테이블 참조가 필요 없어(로그인 주체가
  // AdminUser라 Student가 아니다) 이름을 문자열로 그대로 저장한다 — logAudit의 actorName과
  // 같은 방식이다.
  studentId       Int?
  student         Student?     @relation(fields: [studentId], references: [id])
  authorAdminName String?
  // 댓글(대댓글, parentId가 있는 글)은 제목 없이 바로 달 수 있어야 해서 선택값이다 —
  // 최상위 후기 글만 제목을 요구한다(admin-login 라우트가 이를 검증한다).
  title           String?
  content         String       @db.Text
  views           Int          @default(0)
  createdAt       DateTime     @default(now())

  @@index([siteId])
  @@index([studentId])
  @@index([parentId])
  @@index([agentId])
  @@map("review_posts")
}
